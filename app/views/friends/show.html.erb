<div id="<%= dom_id @friend %>" class="container my-5 p-5">
  <div>
    <strong>First name:</strong>
    <%= @friend.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= @friend.last_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= @friend.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= @friend.phone %>
  </div>

  <div>
    <strong>Twitter:</strong>
    <%= @friend.twitter %>
  </div>

</div>

<div class="btn-group" role="group" aria-label="Basic mixed styles example">
  <%= link_to "Edit this friend",
  edit_friend_path(@friend),
  class: "btn-outline theme-info" %>
  <%= link_to "Back to friends", friends_path, class: "btn-outline theme-info" %>
</div>
<br>
<br>
<div>
  <%= button_to "Destroy this friend",
  @friend,
  method: :delete,
  data: {
    turbo_confirm: "Are you sure?",
  },
  class: "btn-outline theme-danger" %>
</div>
