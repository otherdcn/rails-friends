<tr>
  <th scope="row"><%= friend.id %></th>
  <td><%= friend.first_name %></td>
  <td><%= friend.last_name %></td>
  <td><%= friend.email %></td>
  <td><%= friend.phone %></td>
  <td><%= friend.twitter %></td>
  <td><%= link_to "Show", friend, class: "btn-text theme-info" %></td>
  <td><%= link_to "Edit", edit_friend_path(friend), class: "btn-text theme-info" %></td>
  <td><%= button_to "Delete",
    friend,
    method: :delete,
    data: {
      turbo_confirm: "Are you sure?",
    },
    class: "btn-text theme-danger" %>
  </td>
</tr>
